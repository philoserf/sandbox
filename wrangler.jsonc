{
  "name": "sandbox",
  "compatibility_date": "2026-10-12",
  // Runs before every deploy, on a Mac or in Workers Builds. The validate pass
  // renders drafts and future-dated posts in memory, so one written ahead of
  // time fails here rather than on the day it publishes. rm -rf because Hugo
  // never prunes public/.
  "build": {
    "command": "hugo --buildFuture -D --renderToMemory --gc --panicOnWarning && rm -rf public && hugo --gc --minify --panicOnWarning",
  },
  "assets": { "directory": "./public", "not_found_handling": "404-page" },
}
